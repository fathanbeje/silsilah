{
    admin off
    auto_https off
    persist_config off

    servers {
        trusted_proxies static private_ranges
    }
}

:8092 {
    root * /www/wwwroot/bani-syamsuri.eu.org/public
    encode zstd gzip

    @blocked_methods method TRACE TRACK
    respond @blocked_methods 405

    @sensitive path_regexp sensitive (?i)(^|/)(?:\.env|\.git|\.htaccess|\.htpasswd|\.svn|\.DS_Store|composer\.json|composer\.lock|package\.json|package-lock\.json|yarn\.lock)|\.(sql|bak|old|backup|log)(?:\.|$)
    respond @sensitive 404

    @immutable_assets path *.css *.js *.mjs *.map *.woff *.woff2 *.ttf *.eot *.svg *.png *.jpg *.jpeg *.gif *.webp *.avif *.ico
    header @immutable_assets Cache-Control "public, max-age=604800"

    @storage_assets path /storage/*
    header @storage_assets Cache-Control "public, max-age=86400"

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
    }

    php_server {
        worker {
            file /www/wwwroot/bani-syamsuri.eu.org/worker/entry.php
            num 4
            env APP_ENABLE_WORKER 1
            env APP_WORKER_MAX_REQUESTS 500
            env APP_WORKER_GC_EVERY 1
            env APP_WORKER_HEALTH_PATH /_franken/health
        }
    }

    file_server
}
